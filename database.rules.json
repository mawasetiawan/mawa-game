{
  "rules": {
    "rooms": {
      "general": {
        "messages": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && query.orderByKey && query.limitToLast > 0 && query.limitToLast <= 100",
          "$messageId": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && !data.exists() && newData.exists() && $messageId.matches(/^[-0-9A-Z_a-z]{20}$/)",
            ".validate": "newData.hasChildren(['uid', 'name', 'text'])",
            "uid": {
              ".validate": "newData.val() == auth.uid"
            },
            "name": {
              ".validate": "newData.isString() && (auth.token.name == null ? newData.val() == 'Pemain' : newData.val() == auth.token.name)"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "presence": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com'",
      "$uid": {
        "$connection": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && auth.uid == $uid",
          ".validate": "newData.hasChildren(['name', 'photo'])",
          "name": {
            ".validate": "newData.isString() && (auth.token.name == null ? newData.val() == 'Pemain' : newData.val() == auth.token.name)"
          },
          "photo": {
            ".validate": "newData.isString() && newData.val().length <= 1024"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "invites": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && auth.uid == $uid",
        "$map": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && $uid != auth.uid && root.child('maps').child($map).child('meta').child('host').val() == auth.uid && newData.exists()",
          ".validate": "newData.hasChildren(['from'])",
          "from": {
            ".validate": "newData.val() == auth.uid"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "maps": {
      "$map": {
        "meta": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && (root.child('maps').child($map).child('meta').child('host').val() == auth.uid || root.child('invites').child(auth.uid).child($map).exists())",
          ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['host', 'name'])",
          "host": {
            ".validate": "newData.val() == auth.uid"
          },
          "name": {
            ".validate": "newData.isString() && (auth.token.name == null ? newData.val() == 'Pemain' : newData.val() == auth.token.name)"
          },
          "$other": {
            ".validate": false
          }
        },
        "messages": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && (root.child('maps').child($map).child('meta').child('host').val() == auth.uid || root.child('invites').child(auth.uid).child($map).exists()) && query.orderByKey && query.limitToLast > 0 && query.limitToLast <= 100",
          "$messageId": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && (root.child('maps').child($map).child('meta').child('host').val() == auth.uid || root.child('invites').child(auth.uid).child($map).exists()) && !data.exists() && newData.exists() && $messageId.matches(/^[-0-9A-Z_a-z]{20}$/)",
            ".validate": "newData.hasChildren(['uid', 'name', 'text'])",
            "uid": {
              ".validate": "newData.val() == auth.uid"
            },
            "name": {
              ".validate": "newData.isString() && (auth.token.name == null ? newData.val() == 'Pemain' : newData.val() == auth.token.name)"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "partySeats": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && auth.uid == $uid",
        ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && auth.uid == $uid && (!data.exists() || newData.val() == data.val() || !newData.parent().parent().child('partyRooms').child(data.val()).child('members').child($uid).exists())",
        ".validate": "newData.isString() && newData.val().matches(/^[-0-9A-Z_a-z]{20}$/) && newData.parent().parent().child('partyRooms').child(newData.val()).child('members').child($uid).exists()"
      }
    },
    "partyInvites": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && auth.uid == $uid",
        "$party": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && ((auth.uid == $uid && !newData.exists()) || (auth.uid != $uid && newData.exists() && newData.parent().parent().parent().child('partyRooms').child($party).child('state').child('host').val() == auth.uid && newData.parent().parent().parent().child('partyRooms').child($party).child('state').child('phase').val() == 'waiting' && newData.parent().parent().parent().child('partySeats').child(auth.uid).val() == $party))",
          ".validate": "newData.hasChildren(['from', 'name'])",
          "from": {
            ".validate": "newData.val() == auth.uid"
          },
          "name": {
            ".validate": "newData.isString() && (auth.token.name == null ? newData.val() == 'Pemain' : newData.val() == auth.token.name)"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "partyRooms": {
      "$party": {
        "state": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && (root.child('partySeats').child(auth.uid).val() == $party || root.child('partyInvites').child(auth.uid).child($party).exists())",
          ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && newData.exists() && ((!data.exists() && newData.parent().parent().parent().child('partySeats').child(auth.uid).val() == $party && newData.child('phase').val() == 'waiting') || (data.child('host').val() == auth.uid && data.child('phase').val() != 'closed' && newData.child('host').val() == data.child('host').val() && newData.child('name').val() == data.child('name').val() && (newData.child('phase').val() == 'closed' || (data.child('phase').val() == 'waiting' && newData.child('phase').val() == 'playing' && newData.parent().parent().parent().child('partySeats').child(auth.uid).val() == $party))))",
          ".validate": "newData.hasChildren(['host', 'name', 'phase'])",
          "host": {
            ".validate": "newData.val() == auth.uid"
          },
          "name": {
            ".validate": "newData.isString()"
          },
          "phase": {
            ".validate": "newData.isString()"
          },
          "$other": {
            ".validate": false
          }
        },
        "members": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && root.child('partySeats').child(auth.uid).val() == $party",
          "$uid": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && auth.uid == $uid && ((newData.exists() && !data.exists() && newData.parent().parent().parent().parent().child('partySeats').child(auth.uid).val() == $party && newData.parent().parent().parent().parent().child('partyRooms').child($party).child('state').child('phase').val() == 'waiting' && (newData.parent().parent().parent().parent().child('partyRooms').child($party).child('state').child('host').val() == auth.uid || (root.child('partyInvites').child(auth.uid).child($party).exists() && root.child('partyRooms').child($party).child('state').child('phase').val() == 'waiting'))) || (!newData.exists() && newData.parent().parent().parent().parent().child('partySeats').child(auth.uid).val() != $party))",
            ".validate": "newData.hasChildren(['name', 'photo'])",
            "name": {
              ".validate": "newData.isString() && (auth.token.name == null ? newData.val() == 'Pemain' : newData.val() == auth.token.name)"
            },
            "photo": {
              ".validate": "newData.isString() && newData.val().length <= 1024"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "messages": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && root.child('partySeats').child(auth.uid).val() == $party && root.child('partyRooms').child($party).child('state').child('phase').val() == 'playing' && query.orderByKey && query.limitToLast > 0 && query.limitToLast <= 100",
          "$messageId": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && root.child('partySeats').child(auth.uid).val() == $party && root.child('partyRooms').child($party).child('state').child('phase').val() == 'playing' && !data.exists() && newData.exists() && $messageId.matches(/^[-0-9A-Z_a-z]{20}$/)",
            ".validate": "newData.hasChildren(['uid', 'name', 'text'])",
            "uid": {
              ".validate": "newData.val() == auth.uid"
            },
            "name": {
              ".validate": "newData.isString() && (auth.token.name == null ? newData.val() == 'Pemain' : newData.val() == auth.token.name)"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "positions": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && root.child('partySeats').child(auth.uid).val() == $party && root.child('partyRooms').child($party).child('state').child('phase').val() == 'playing'",
          "$uid": {
            "$connection": {
              ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && auth.uid == $uid && $connection.matches(/^[-0-9A-Z_a-z]{20}$/) && (!newData.exists() || (root.child('partySeats').child(auth.uid).val() == $party && root.child('partyRooms').child($party).child('state').child('phase').val() == 'playing'))",
              ".validate": "newData.hasChildren(['x', 'y', 'z', 'crouch'])",
              "x": {
                ".validate": "newData.isNumber() && newData.val() >= -49 && newData.val() <= 49"
              },
              "y": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4"
              },
              "z": {
                ".validate": "newData.isNumber() && newData.val() >= -49 && newData.val() <= 49"
              },
              "crouch": {
                ".validate": "newData.isBoolean()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    },
    "gameSettings": {
      ".read": true,
      ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && auth.token.email_verified == true && auth.token.email == 'mawadatulsetiawan@gmail.com' && newData.exists()",
      ".validate": "newData.hasChildren([\"zoomMin\",\"zoomMax\",\"orbitSpeed\",\"zoomSpeed\",\"walkSpeed\",\"runSpeed\",\"sprintSpeed\",\"dashSpeed\",\"dashSeconds\",\"jumpSpeed\",\"gravity\",\"invertPitch\",\"invertYaw\",\"invertZoom\"]) && newData.child('zoomMin').val() <= newData.child('zoomMax').val() && newData.child('walkSpeed').val() <= newData.child('runSpeed').val() && newData.child('runSpeed').val() <= newData.child('sprintSpeed').val() && (!newData.child('minFov').exists() || !newData.child('maxFov').exists() || newData.child('minFov').val() <= newData.child('maxFov').val())",
      "zoomMin": {
        ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 16"
      },
      "zoomMax": {
        ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 30"
      },
      "orbitSpeed": {
        ".validate": "newData.isNumber() && newData.val() >= 0.1 && newData.val() <= 3"
      },
      "zoomSpeed": {
        ".validate": "newData.isNumber() && newData.val() >= 0.1 && newData.val() <= 3"
      },
      "walkSpeed": {
        ".validate": "newData.isNumber() && newData.val() >= 0.5 && newData.val() <= 10"
      },
      "runSpeed": {
        ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 15"
      },
      "sprintSpeed": {
        ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 24"
      },
      "dashSpeed": {
        ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 36"
      },
      "dashSeconds": {
        ".validate": "newData.isNumber() && newData.val() >= 0.05 && newData.val() <= 1"
      },
      "jumpSpeed": {
        ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 8"
      },
      "gravity": {
        ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 40"
      },
      "invertPitch": {
        ".validate": "newData.isBoolean()"
      },
      "invertYaw": {
        ".validate": "newData.isBoolean()"
      },
      "invertZoom": {
        ".validate": "newData.isBoolean()"
      },
      "$other": {
        ".validate": false
      },
      "autoFov": {
        ".validate": "newData.isBoolean()"
      },
      "baseFov": {
        ".validate": "newData.isNumber() && newData.val() >= 35 && newData.val() <= 95"
      },
      "minFov": {
        ".validate": "newData.isNumber() && newData.val() >= 35 && newData.val() <= 95"
      },
      "maxFov": {
        ".validate": "newData.isNumber() && newData.val() >= 35 && newData.val() <= 95"
      }
    }
  }
}
